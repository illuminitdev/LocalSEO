# =============================================================================
# Local SEO (LocalPulse) — backend env
# Stacks: LocalSeoApi-dev | LocalSeoApi-prod
# Portal prod: https://app.zappsites.com
# Marketing:   https://www.zappsites.com | staging: https://staging.zappsites.com
# =============================================================================

NODE_ENV=development
AUTH_REQUIRED=true
ENTITLEMENTS_DISABLED=false
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string

CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- DEVELOPMENT (active) — LocalSeoApi-dev ---
STAGE=dev
SHARED_RDS=true
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:288761766237:secret:ZappsitesDatabase-dev/credentials-v7vlwH
DB_PROXY_ENDPOINT=rdsproxy.proxy-cehyac2sc676.us-east-1.rds.amazonaws.com
DB_NAME=zappsites
DB_USER=zappsites_admin
API_BASE_URL=https://ud9zl0ww6d.execute-api.us-east-1.amazonaws.com
ADMIN_EMAIL=admin@localseo.net
ADMIN_PASSWORD=localseo@2026

# Temporary dev portal test client (all plan features; not used on prod)
DEV_CLIENT_EMAIL=client@email.com
DEV_CLIENT_PASSWORD=client@123
DEV_CLIENT_PLAN_ID=complete-growth-system

# Dev-only test API keys (never set on prod stack)
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=

