# Free Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

PORT=5000

# Stripe (test keys from dashboard.stripe.com — never commit real keys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Where Stripe redirects after payment (Vite dev: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Optional SMTP for booking confirmation emails (logs to console if unset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# BOOKING_EMAIL_FROM=bookings@yourdomain.com
