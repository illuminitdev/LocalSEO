# Copy to backend/.env and fill in values

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

PORT=5000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Postgres — Neon (pooled) for app queries; unpooled for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# Set to true later when you want login required for host dashboard
JWT_SECRET=change-this-to-a-long-random-string

# AUTH_REQUIRED=true  # uncomment later to require login for /api/host/*

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# BOOKING_EMAIL_FROM=bookings@yourdomain.com
