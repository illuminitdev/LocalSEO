# Copy to backend/.env and fill in values

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

PORT=5000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Postgres — Neon (copy exact strings from Neon dashboard → Connect; do NOT use placeholders)
# Pooled URL host looks like: ep-xxxx-pooler.c-2.us-east-2.aws.neon.tech
DATABASE_URL=
# Direct (unpooled) URL host looks like: ep-xxxx.c-2.us-east-2.aws.neon.tech
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# Host auth — require JWT for /api/host/* (set true for SaaS gate)
JWT_SECRET=change-this-to-a-long-random-string
AUTH_REQUIRED=true

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Places (Add location / competitors) — enable Places API (New) and/or Places API in Cloud Console
GOOGLE_PLACES_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# BOOKING_EMAIL_FROM=bookings@yourdomain.com
