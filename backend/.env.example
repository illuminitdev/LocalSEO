# Local SEO backend — copy to .env (never commit real secrets)

NODE_ENV=development
STAGE=dev
AUTH_REQUIRED=true
ENTITLEMENTS_DISABLED=false
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string

CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_BASE_URL=https://ud9zl0ww6d.execute-api.us-east-1.amazonaws.com

# Dev Gemini (optional). Paid key goes in GEMINI_API_KEY_PROD for cdk -c stage=prod only.
GEMINI_API_KEY=
GEMINI_API_KEY_PROD=
GOOGLE_PLACES_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Stripe TEST keys — LocalSeoApi-dev / local only (never commit secrets)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe LIVE — CDK -c stage=prod only
STRIPE_SECRET_KEY_PROD=
STRIPE_PUBLISHABLE_KEY_PROD=
STRIPE_WEBHOOK_SECRET_PROD=

STRIPE_PLATFORM_FEE_BPS=500
STRIPE_CONNECT_DEFAULT_COUNTRY=GB
