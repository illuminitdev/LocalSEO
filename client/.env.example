# =============================================================================
# Local SEO client (Vite) — API URL from env only (never hardcoded in source)
# =============================================================================

# Stage label (dev | prod) — used for UI / logging; not a secret
VITE_STAGE=dev

# Required: LocalSeoApi Gateway URL for this stage
VITE_API_BASE=https://ud9zl0ww6d.execute-api.us-east-1.amazonaws.com

VITE_MARKETING_URL=https://www.zappsites.com
VITE_STAGING_MARKETING_URL=https://staging.zappsites.com

# --- Production (comment above, uncomment below) ---
# VITE_STAGE=prod
# VITE_API_BASE=https://zw8pq7vyi2.execute-api.us-east-1.amazonaws.com
# VITE_APP_URL=https://app.zappsites.com

# --- Optional: local Express instead of deployed API ---
# VITE_USE_LOCAL_API=true
