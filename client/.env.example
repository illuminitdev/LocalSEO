# =============================================================================
# Local SEO client (Vite) — localhost talks to deployed API (no local backend)
# Portal prod: https://app.zappsites.com
# Marketing:   https://www.zappsites.com  |  staging: https://staging.zappsites.com
# =============================================================================

# Switch which deployed API localhost uses:
#   dev  → LocalSeoApi-dev
#   prod → LocalSeoApi-prod
VITE_STAGE=dev

VITE_MARKETING_URL=https://www.zappsites.com
VITE_STAGING_MARKETING_URL=https://staging.zappsites.com

# --- Use prod API from localhost (comment dev block above, uncomment below) ---
# VITE_STAGE=prod
# VITE_APP_URL=https://app.zappsites.com

# --- Optional: run local Express instead (npm run dev:backend in another terminal) ---
# VITE_USE_LOCAL_API=true
# VITE_STAGE=dev

# --- Optional explicit API override (normally not needed) ---
# VITE_API_BASE=https://ud9zl0ww6d.execute-api.us-east-1.amazonaws.com
